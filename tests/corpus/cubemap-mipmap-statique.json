{
  "ver": "0.1",
  "info": {
    "id": "CUBEMA",
    "name": "Cubemap mipmap",
    "username": "ShaderView",
    "description": "textureLod sur un cubemap média (mipmaps).",
    "tags": [
      "corpus",
      "regression"
    ],
    "license": "GPL-3.0-or-later"
  },
  "renderpass": [
    {
      "type": "image",
      "name": "Image",
      "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n  vec3 dir = normalize(vec3(uv, 1.0));\n  fragColor = vec4(textureLod(iChannel0, dir, floor(fragCoord.x / iResolution.x * 5.0)).rgb, 1.0);\n}",
      "inputs": [
        {
          "channel": 0,
          "ctype": "cubemap",
          "src": "/media/a/cube-mip.png",
          "sampler": {
            "filter": "mipmap",
            "wrap": "clamp",
            "vflip": "false",
            "srgb": "false",
            "internal": "byte"
          }
        }
      ],
      "outputs": [
        {
          "id": "4dfGRr",
          "channel": 0
        }
      ]
    }
  ]
}
