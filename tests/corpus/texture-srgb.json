{
  "ver": "0.1",
  "info": {
    "id": "TEXTUR",
    "name": "Texture sRGB",
    "username": "ShaderView",
    "description": "Entrée marquée srgb : conversion en linéaire à l’échantillonnage.",
    "tags": [
      "corpus",
      "regression"
    ],
    "license": "GPL-3.0-or-later"
  },
  "renderpass": [
    {
      "type": "image",
      "name": "Image",
      "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec3 a = texture(iChannel0, uv * 2.0).rgb;\n  vec3 b = texture(iChannel1, uv * 2.0).rgb;\n  fragColor = vec4(mix(a, b, step(0.5, uv.y)), 1.0);\n}",
      "inputs": [
        {
          "channel": 0,
          "ctype": "texture",
          "src": "/media/a/srgb-oui.png",
          "sampler": {
            "filter": "mipmap",
            "wrap": "repeat",
            "vflip": "false",
            "srgb": "true",
            "internal": "byte"
          }
        },
        {
          "channel": 1,
          "ctype": "texture",
          "src": "/media/a/srgb-non.png",
          "sampler": {
            "filter": "mipmap",
            "wrap": "repeat",
            "vflip": "false",
            "srgb": "false",
            "internal": "byte"
          }
        }
      ],
      "outputs": [
        {
          "id": "4dfGRr",
          "channel": 0
        }
      ]
    }
  ]
}
